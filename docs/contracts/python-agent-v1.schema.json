        "subjectUserId": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "memberId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "traceId": {
          "type": "string",
          "minLength": 1
