# initialize-local generates the four independent secrets below in ignored kangban.local.env.
# Fill local infrastructure credentials yourself. This file is data, not a shell script.
KANGBAN_DB_URL=jdbc:mysql://127.0.0.1:3306/kangban?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&createDatabaseIfNotExist=true
KANGBAN_DB_USERNAME=root
KANGBAN_DB_PASSWORD=YOUR_MYSQL_PASSWORD
KANGBAN_REDIS_HOST=127.0.0.1
KANGBAN_REDIS_PORT=6379
KANGBAN_REDIS_PASSWORD=
KANGBAN_MINIO_ENDPOINT=http://127.0.0.1:9000
KANGBAN_MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
KANGBAN_MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
KANGBAN_MINIO_BUCKET=kangban-files
KANGBAN_JWT_SECRET=GENERATE_JWT_SECRET
KANGBAN_CAPTCHA_SECRET=GENERATE_CAPTCHA_SECRET
APP_AGENT_CONTEXT_SECRET=GENERATE_CONTEXT_SECRET
APP_AGENT_SERVICE_TOKEN=GENERATE_SERVICE_TOKEN
APP_AGENT_INTERNAL_MAX_REQUEST_MS=170000
APP_AGENT_INTERNAL_CONNECT_TIMEOUT_MS=3000
APP_AI_PROVIDER=mock
APP_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
APP_AI_API_KEY=
APP_AI_AI_MODEL=qwen3.7-plus-2026-05-26
APP_AI_CONNECT_TIMEOUT=10000
APP_AI_READ_TIMEOUT=120000
APP_RAG_ENABLED=false
APP_RAG_PRIVATE_ENABLED=true
APP_RAG_VECTOR_STORE=mysql-jdbc
APP_RAG_EMBEDDING_PROVIDER=local
APP_MCP_PUBLIC_ENABLED=false
APP_BASE_URL=http://127.0.0.1:5173
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
