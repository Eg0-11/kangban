[Unit]
Description=Kangban Python Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kangban/kangban-agent
EnvironmentFile=/opt/kangban/kangban-agent.env
ExecStart=/opt/kangban/kangban-agent/.venv/bin/python -m uvicorn kangban_agent.main:create_app --factory --app-dir src --host 127.0.0.1 --port 8093 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
