# Python service only. Never put APP_AGENT_CONTEXT_SECRET or database credentials here.
APP_AGENT_SERVICE_TOKEN=CHANGE_ME_SEPARATE_AGENT_SERVICE_TOKEN
# Matches SERVER_PORT=8081 in app.env.example; change both when moving Java.
APP_AGENT_JAVA_BASE_URL=http://127.0.0.1:8081
APP_AGENT_INTERNAL_MAX_REQUEST_MS=170000
APP_AI_PROVIDER=qwen
APP_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
APP_AI_API_KEY=CHANGE_ME_AI_API_KEY
APP_AI_AI_MODEL=qwen3.7-plus-2026-05-26
APP_AI_CONNECT_TIMEOUT=10000
APP_AI_READ_TIMEOUT=120000
