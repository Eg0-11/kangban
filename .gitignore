# Local secrets
kangban-server/.env
kangban-server/.env.*
!kangban-server/.env.example
!kangban-server/.env.production.example
kangban-web/.env.local
kangban-web/.env.*
!kangban-web/.env.example
!kangban-web/.env.production.example

# Local editor and OS files
.DS_Store
**/.DS_Store
.idea/
**/.idea/
*.iml
*.log

# Separate nested projects; they are not part of the Kangban application.
/agent/
/kangban-server/lumenx/

# Build outputs
kangban-server/target/
kangban-web/dist/
tianjin-medical-mcp/target/

# Dependencies
kangban-web/node_modules/

# Python Agent local environment, credentials and generated files
kangban-agent/.venv/
kangban-agent/.venv-*/
kangban-agent/.env
kangban-agent/.env.*
!kangban-agent/.env.example
kangban-agent/.pytest_cache/
kangban-agent/.ruff_cache/
kangban-agent/.runtime/
kangban-agent/.run/
**/__pycache__/
*.py[cod]

# Local launcher and deployment credentials
/kangban.local.env
/deploy/ecs/.env
/deploy/ecs/*.env
