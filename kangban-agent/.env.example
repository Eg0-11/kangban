# Inject into the Python process environment; the service does not automatically load this file.
# Match the Java service token. Keep the separate Java signing key out of this process.
APP_AGENT_SERVICE_TOKEN=YOUR_SEPARATE_INTERNAL_AGENT_SERVICE_TOKEN
APP_AGENT_JAVA_BASE_URL=http://127.0.0.1:8080
APP_AGENT_INTERNAL_MAX_REQUEST_MS=170000
APP_AI_PROVIDER=mock
APP_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
APP_AI_API_KEY=
APP_AI_AI_MODEL=qwen3.7-plus-2026-05-26
APP_AI_CONNECT_TIMEOUT=10000
APP_AI_READ_TIMEOUT=120000
